platform :ios, '18.2'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

def flutter_root
  generated = File.expand_path('../../example/ios/Flutter/Generated.xcconfig', __dir__)
  File.foreach(generated) do |line|
    match = line.match(/FLUTTER_ROOT\=(.*)/)
    return match[1].strip if match
  end
  raise "FLUTTER_ROOT not found in #{generated}; run flutter pub get in example first"
end

require File.expand_path('packages/flutter_tools/bin/podhelper', flutter_root)

flutter_ios_podfile_setup

target 'CompatibilityHost' do
  use_frameworks!
  flutter_install_all_ios_pods(File.expand_path('../../example/ios', __dir__))
  # The compatibility host imports the production plugin directly. Keep this
  # explicit so it continues to exercise CocoaPods when Flutter SwiftPM is
  # enabled globally on a developer machine.
  pod 'workspace_flutter', :path => '..'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
